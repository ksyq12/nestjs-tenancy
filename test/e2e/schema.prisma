// Test-only Prisma schema for E2E tests.
// Matches the users table created by setup.sql.
generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int    @id @default(autoincrement())
  tenant_id String
  name      String
  email     String

  @@map("users")
}

model Country {
  id   Int    @id @default(autoincrement())
  name String
  code String

  @@map("countries")
}
